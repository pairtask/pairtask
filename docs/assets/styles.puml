@startuml
' Shared style for the diagrams in docs/assets: every diagram starts with
'   !include styles.puml
' Roles are stereotypes on elements, flows are stereotypes on arrows, and the
' colour variables below are reused by each diagram's legend.

!$operatorColor = "#fff3b0"
!$agentColor = "#e7f5eb"
!$brokerColor = "#e3efff"
!$socketColor = "#fce4f0"
!$storageColor = "#f0eaff"
!$peerColor = "#dff3f7"
!$routeColor = "#eeeeee"
!$tbdColor = "#ffd6a5"

<style>
title {
    FontSize 25
}
document {
    Margin 40
}

rectangle {
    LineStyle 5
    LineColor #grey
    LineThickness 2
}

.Operator {
    BackgroundColor $operatorColor
}
.Agent {
    BackgroundColor $agentColor
}
.Broker {
    BackgroundColor $brokerColor
}
.Socket {
    BackgroundColor $socketColor
}
.Storage {
    BackgroundColor $storageColor
}
.Peer {
    BackgroundColor $peerColor
}
.Route {
    BackgroundColor $routeColor
}
.tbd {
    BackgroundColor $tbdColor
}

.operatorFlow {
    LineColor #indigo
    LineThickness 1
}
.messageFlow {
    LineColor #lawnGreen
    LineThickness 2
}
.pairingFlow {
    LineColor #deepPink
    LineThickness 2
}
.dataFlow {
    LineColor #grey
    LineThickness 1
}

.note {
    FontStyle italic
    BackgroundColor #white
    FontSize 15
}

legend {
    FontSize 15
    Padding 15
    BackgroundColor #f0f0f0
}
</style>

hide <<group>> stereotype
hide <<tbd>> stereotype
hide <<Operator>> stereotype
hide <<Agent>> stereotype
hide <<Broker>> stereotype
hide <<Socket>> stereotype
hide <<Storage>> stereotype
hide <<Peer>> stereotype
hide <<Route>> stereotype

skinparam {
'    linetype ortho
    padding 15
    nodesep 50
    ranksep 30
}
@enduml
