#!/usr/bin/python3
"""Launch a tool from the active store generation.

Invoked as `pairtask-tool NAME ARGS…` (or the legacy `collab-tool NAME ARGS…`),
or through a symlink named after the tool.
The generation is resolved once and fixed in the child's environment, so a
later activation on another root never changes what a running tool sees.
"""

import os
from pathlib import Path
import sys

sys.path.insert(0, "/usr/local/lib/pairtask")
import tool_store  # noqa: E402

EXIT_MAINTENANCE, EXIT_MISSING = 75, 127


def environment(name, entry, base=None):
    """The child's environment; `base` (the artifact root) is accepted for
    callers that pass it, GOROOT derives from the entry itself."""
    env = dict(os.environ)
    env["PATH"] = f"{entry.parent}:{env.get('PATH', '/usr/bin:/bin')}"
    if name in ("go", "gofmt"):
        env["GOROOT"] = str(entry.parent.parent)  # the lock's entry is go/bin/go
    return env


def main(argv):
    program = Path(argv[0]).name
    if program in ("pairtask-tool", "collab-tool"):
        if len(argv) < 2:
            sys.exit(f"usage: {program} NAME [ARGS…]")
        name, args = argv[1], argv[2:]
    else:
        name, args = program, argv[1:]
    # Readiness, the entry and its environment are read together under the
    # store's shared lock, so an update can't flip `current` between them;
    # the exec happens after, on paths no update ever removes.
    with tool_store.launch_lock():
        reason = tool_store.ready()
        if reason:
            print(f"{name}: {reason}", file=sys.stderr)
            sys.exit(EXIT_MAINTENANCE)
        entry = tool_store.Store().resolve_name(name)
        if entry is None or not entry.is_file():
            print(f"{name} is not installed in this sandbox; enable it in the preset and run rollout", file=sys.stderr)
            sys.exit(EXIT_MISSING)
        env = environment(name, entry)
    os.execve(entry, [str(entry), *args], env)


if __name__ == "__main__":
    try:
        main(sys.argv)
    except (tool_store.StoreError, OSError) as error:
        print(f"pairtask-tool: {error}", file=sys.stderr)
        sys.exit(1)
