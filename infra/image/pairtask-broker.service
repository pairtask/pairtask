[Unit]
Description=collab-ai local message broker
After=local-fs.target
Requires=pairtask-client-setup.service
After=pairtask-client-setup.service
Requires=pairtask-workspace-setup.service
After=pairtask-workspace-setup.service
# The secured runtime reserves its state for host-administered services.
ConditionPathIsMountPoint=!/var/lib/collab-ai-secured
ConditionPathIsMountPoint=!/mnt/collab-ipc
# Nor does the pairing route's connector run a broker.
ConditionPathIsMountPoint=!/mnt/pairtask-egress

[Service]
User=agent
Group=agent
WorkingDirectory=/workspace
Environment=PAIRTASK_SOCKET_PATH=/tmp/collab-ai.sock
Environment=PAIRTASK_DB_PATH=/var/lib/collab-ai/inboxes.db
ExecStart=/usr/local/lib/pairtask/pairtask-broker
Restart=on-failure
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
