#!/usr/bin/env python3
"""Prepare the opt-in pairing route (#178): the shared sockets' directories,
stale sockets left by a stopped daemon, and the secured broker's route
settings. Never touches broker state, the database or the workspace key."""

import grp
import json
import os
from pathlib import Path
import pwd
import re
import socket
import stat
import sys
import unicodedata


STATE = Path("/var/lib/collab-ai-secured")
INGRESS = Path("/mnt/pairtask-pairing")
EGRESS = Path("/mnt/pairtask-egress")
ENV = Path("/run/pairtask/pairing.env")
PEER_GROUP, PEER_GID = "collab-peer", 1050
PEER_USER, PEER_UID = "peer", 1052
ENV_KEYS = ("PAIRTASK_PAIRING_SOCKET", "PAIRTASK_PAIRING_SOCKET_GROUP", "PAIRTASK_PAIRING_EGRESS", "PAIRTASK_PAIRING_NAME")
# The name this workspace pairs under (#277), written by provisioning.
NAME_FILE = Path("/etc/pairtask/pairing-name.json")
NAME_BYTES = 64


def check_role(role, state=STATE, ingress=INGRESS, egress=EGRESS, mounted=os.path.ismount):
    """secured has its state and both route mounts; connector has both route
    mounts and no secured state. Mounts decide, never mere directories."""
    if not (mounted(str(ingress)) and mounted(str(egress))):
        raise ValueError("the pairing route needs both route mounts")
    expected = {"secured": True, "connector": False}
    if role not in expected:
        raise ValueError(f"unknown role: {role}")
    if mounted(str(state)) != expected[role]:
        raise ValueError(f"this instance is not the {role}")


def require_ids():
    """The image's route identities must be exactly the expected ones."""
    group = grp.getgrnam(PEER_GROUP)
    user = pwd.getpwnam(PEER_USER)
    if group.gr_gid != PEER_GID:
        raise ValueError(f"{PEER_GROUP} must be GID {PEER_GID}")
    if (user.pw_uid, user.pw_gid) != (PEER_UID, PEER_GID):
        raise ValueError(f"{PEER_USER} must be UID {PEER_UID} in GID {PEER_GID}")


def prepare_shared_dir(path, uid, gid):
    """A shared socket directory: real, owned uid:gid, 0750. Its contents are
    left alone."""
    info = path.lstat()
    if not stat.S_ISDIR(info.st_mode):
        raise ValueError(f"Refusing a non-directory route mount: {path}")
    os.chown(path, uid, gid)
    path.chmod(0o750)


def remove_stale_socket(path, uid):
    """Removes a socket this owner left behind, only when nothing answers."""
    if not path.exists() and not path.is_symlink():
        return
    info = path.lstat()
    if not owned_socket(info, uid):
        raise ValueError(f"Refusing unexpected pairing endpoint: {path}")
    with socket.socket(socket.AF_UNIX) as connection:
        connection.settimeout(2)
        try:
            connection.connect(str(path))
        except ConnectionRefusedError:
            unlink_if_same(path, info, uid)
            return
    raise ValueError(f"Pairing endpoint is already active: {path}")


def owned_socket(info, uid):
    return stat.S_ISSOCK(info.st_mode) and info.st_uid == uid


def unlink_if_same(path, before, uid):
    """Unlinks only the socket that refused, not one put in its place."""
    after = path.lstat()
    same = (after.st_dev, after.st_ino) == (before.st_dev, before.st_ino)
    if not same or not owned_socket(after, uid):
        raise ValueError(f"Pairing endpoint changed while probing: {path}")
    path.unlink()


# A value systemd reads unchanged without quotes.
PLAIN_VALUE = re.compile(r"[A-Za-z0-9/_.:@+-]+")


def env_line(key, value):
    """One setting as systemd's EnvironmentFile reads it: a plain value as it
    is, any other double-quoted, backslash and quote escaped, so spaces, #, $
    and % stay as they are."""
    if key not in ENV_KEYS:
        raise ValueError(f"unexpected setting: {key}")
    if any(c in value for c in "\n\r\0"):
        raise ValueError(f"unsafe value for {key}")
    if PLAIN_VALUE.fullmatch(value):
        return f"{key}={value}\n"
    escaped = value.replace("\\", "\\\\").replace('"', '\\"')
    return f'{key}="{escaped}"\n'


def read_name(path=NAME_FILE):
    """The name provisioning gave, "" when it cleared it, or None without a
    file. Anything malformed is refused, never taken in part."""
    if not path.exists():
        return None
    data = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(data, dict) or not isinstance(data.get("name"), str):
        raise ValueError(f"{path}: want {{\"name\": \"...\"}}")
    name = data["name"]
    if name and not valid_name(name):
        raise ValueError(f"{path}: the name must be at most {NAME_BYTES} bytes of printable text")
    return name


def valid_name(name):
    """As the broker checks it: at most 64 bytes of UTF-8, every character a
    letter, mark, number, punctuation, symbol or the ASCII space."""
    if len(name.encode("utf-8", "surrogatepass")) > NAME_BYTES:
        return False
    return all(c == " " or unicodedata.category(c)[0] in "LMNPS" for c in name)


def write_env(path, gid, values):
    """Writes the broker's route settings atomically, root:gid 0640."""
    temporary = path.with_name(path.name + ".tmp")
    for candidate in (path, temporary):
        if candidate.is_symlink():
            raise ValueError(f"Refusing a symlinked settings path: {candidate}")
    text = "".join(env_line(key, value) for key, value in values.items())
    temporary.unlink(missing_ok=True)
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(descriptor, "w") as stream:
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
        os.chown(temporary, 0, gid)
        temporary.chmod(0o640)
        os.replace(temporary, path)
    except BaseException:
        temporary.unlink(missing_ok=True)  # the old settings stay as they were
        raise


def clear_env(path=ENV):
    """Removes the route settings if they are a regular file; anything else,
    a symlink included, is refused and kept."""
    if not path.exists() and not path.is_symlink():
        return
    if not stat.S_ISREG(path.lstat().st_mode):
        raise ValueError(f"Refusing unexpected settings path: {path}")
    path.unlink()


def private_parent(path, uid=0):
    """The settings' directory: real, owned by uid, writable by no one else.
    Created 0755 when missing."""
    path.mkdir(mode=0o755, exist_ok=True)
    info = path.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != uid or info.st_mode & 0o022:
        raise ValueError(f"Refusing an unsafe settings directory: {path}")


def secured(state=STATE, ingress=INGRESS, egress=EGRESS, env=ENV, name_path=NAME_FILE):
    """Root: the ingress directory and the broker's route settings, with the
    name it pairs under when provisioning gave one. Old settings go first, so
    a failure never leaves them, or an old name, in force."""
    check_role("secured", state, ingress, egress)
    require_ids()
    clear_env(env)
    name = read_name(name_path)
    broker = pwd.getpwnam("broker")
    prepare_shared_dir(ingress, broker.pw_uid, PEER_GID)
    private_parent(env.parent)
    values = {
        "PAIRTASK_PAIRING_SOCKET": str(ingress / "pairing.sock"),
        "PAIRTASK_PAIRING_SOCKET_GROUP": PEER_GROUP,
        "PAIRTASK_PAIRING_EGRESS": "socket:" + str(egress / "egress.sock"),
    }
    if name:  # none or cleared: the broker's default
        values["PAIRTASK_PAIRING_NAME"] = name
    write_env(env, broker.pw_gid, values)


def connector(state=STATE, ingress=INGRESS, egress=EGRESS):
    """Root: the egress directory."""
    check_role("connector", state, ingress, egress)
    require_ids()
    prepare_shared_dir(egress, PEER_UID, PEER_GID)


def clean_endpoint(socket_path, mounted=os.path.ismount):
    """As the socket's owner before its daemon starts: removes only that
    daemon's own stale socket. Without the route mount it does nothing."""
    if not mounted(str(socket_path.parent)):
        return
    remove_stale_socket(socket_path, os.geteuid())


def clean_ingress(ingress=INGRESS):
    clean_endpoint(ingress / "pairing.sock")


def clean_egress(egress=EGRESS):
    clean_endpoint(egress / "egress.sock")


def disable(env=ENV):
    clear_env(env)


COMMANDS = {"secured": secured, "connector": connector, "clean-ingress": clean_ingress,
            "clean-egress": clean_egress, "disable": disable}


def main(argv):
    if len(argv) != 2 or argv[1] not in COMMANDS:
        print("usage: pairtask-pairing-setup secured|connector|clean-ingress|clean-egress|disable", file=sys.stderr)
        return 2
    try:
        COMMANDS[argv[1]]()
    except (OSError, KeyError, ValueError) as error:
        print(f"pairtask-pairing-setup: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
