[Unit]
Description=Unprivileged Codex executor connection
Requires=pairtask-tools-ready.service
After=pairtask-tools-ready.service

[Service]
User=agent
Group=agent
WorkingDirectory=/workspace
Environment=PATH=/usr/local/bin:/usr/local/go/bin:/usr/bin:/bin
Environment=HOME=/home/agent
# Build caches in /workspace/.cache, on the projects volume (#400).
EnvironmentFile=-/run/pairtask/cache.env
ExecStart=/usr/local/bin/codex exec-server --listen stdio
StandardInput=socket
StandardOutput=socket
StandardError=journal
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectControlGroups=yes
InaccessiblePaths=-/run/systemd/private -/run/dbus/system_bus_socket
KillMode=control-group
TasksMax=128
TimeoutStopSec=3s
SendSIGKILL=yes
